# Database. Leave empty for local work: an embedded PostgreSQL (PGlite) is stored in .data/pglite.
# Production: a Postgres connection string (Supabase, Neon, RDS…), US region.
DATABASE_URL=

# Site served when a hostname is not in the domains table (local development only).
DEFAULT_SITE=demo

# First owner account created by `npm run db:import`.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=

# Absolute base URL of the admin, used in links inside emails (invitations, password resets, inquiries).
ADMIN_BASE_URL=https://app.yourplatform.com
# Host name of the admin. When set, /admin is only served there (customer domains redirect to it).
ADMIN_HOST=app.yourplatform.com

# Email (Resend). Without a key, emails are recorded in email_outbox but not sent.
RESEND_API_KEY=
EMAIL_FROM="Website <notifications@yourplatform.com>"

# Signs CRM webhook payloads (header x-signature-sha256 = HMAC-SHA256 of the body).
WEBHOOK_SECRET=

# Protects /api/cron/deliver (retries webhooks and failed emails). Schedule it every 5 minutes.
CRON_SECRET=

# Salt for hashing visitor IP addresses (rate limiting without storing raw IPs).
IP_HASH_SALT=

# Cloudflare Turnstile human check on forms (optional; both keys or neither).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upload storage. local (default): files in STORAGE_DIR (default .data/uploads).
# s3: Cloudflare R2 or any S3-compatible bucket; images are then served from STORAGE_PUBLIC_URL.
STORAGE_DRIVER=local
STORAGE_DIR=
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=https://media.yourplatform.com

# ---- SEO (phase 3)
# Address the server uses to crawl its own draft preview for the pre-publish SEO check.
# Default http://127.0.0.1:$PORT — set it when the app runs behind a proxy or in a container.
INTERNAL_ORIGIN=
# Google Search Console: service-account JSON (one line). The sitemap is submitted after every publish
# for sites that set a property under Company settings. Leave empty to skip.
GSC_SERVICE_ACCOUNT_JSON=

# ---- AI site generation (phase 4)
# With a key, the Anthropic model writes the copy; without one, a demo template writer is used.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# anthropic | mock  (default: anthropic when a key is set, otherwise mock)
AI_PROVIDER=
# New sites get the staging address <site-id>.<PLATFORM_DOMAIN> until their own domain is connected.
PLATFORM_DOMAIN=sites.yourplatform.com

# ---- Accounts (phase 5)
# true = anyone can create an account at /admin/signup and build a site. false = invitation only.
ALLOW_SIGNUP=false
# "Sign in with Google" (Google Cloud Console → OAuth client, type Web).
# Authorized redirect URI: <ADMIN_BASE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Custom domains (phase 5)
# What customers point their domain at: a CNAME target (for www.…) and, for bare domains, A-record IPs.
PLATFORM_CNAME_TARGET=sites.yourplatform.com
PLATFORM_A_RECORDS=
# Who issues HTTPS certificates: vercel | cloudflare | caddy | manual
DOMAIN_PROVIDER=manual
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# DNS lookups for domain checks (DNS over HTTPS, JSON API).
DNS_DOH_URL=https://cloudflare-dns.com/dns-query
