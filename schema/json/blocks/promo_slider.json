{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable id, unique within the page"
    },
    "type": {
      "type": "string",
      "const": "promo_slider"
    },
    "slides": {
      "minItems": 1,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "image": {
            "type": "object",
            "properties": {
              "src": {
                "type": "string",
                "minLength": 1
              },
              "alt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 125,
                "description": "Required. Describe what is in the image; never 'image' or the file name"
              },
              "width": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "height": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "src",
              "alt"
            ]
          },
          "link": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 30
              },
              "href": {
                "type": "string",
                "pattern": "^(\\/[a-z0-9\\-\\/#?=&]*|#[a-z0-9-]+|https?:\\/\\/\\S+|mailto:\\S+|tel:\\S+)$"
              }
            },
            "required": [
              "label",
              "href"
            ]
          }
        },
        "required": [
          "title"
        ]
      }
    }
  },
  "required": [
    "id",
    "type",
    "slides"
  ]
}
