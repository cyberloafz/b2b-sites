{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable id, unique within the page"
    },
    "type": {
      "type": "string",
      "const": "header"
    },
    "logo": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string",
          "minLength": 1
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 125,
          "description": "Required. Describe what is in the image; never 'image' or the file name"
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "src",
        "alt"
      ]
    },
    "logoText": {
      "description": "Shown next to the logo mark if set",
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "nav": {
      "minItems": 2,
      "maxItems": 7,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      },
      "description": "Top-level items; up to 3 levels deep"
    },
    "cta": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "href": {
          "type": "string",
          "pattern": "^(\\/[a-z0-9\\-\\/#?=&]*|#[a-z0-9-]+|https?:\\/\\/\\S+|mailto:\\S+|tel:\\S+)$"
        }
      },
      "required": [
        "label",
        "href"
      ],
      "description": "Always-visible inquiry button, e.g. 'Request a Quote'"
    }
  },
  "required": [
    "id",
    "type",
    "logo",
    "nav",
    "cta"
  ],
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "href": {
          "type": "string"
        },
        "children": {
          "maxItems": 24,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "label",
        "href"
      ]
    }
  }
}
