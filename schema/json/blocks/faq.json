{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable id, unique within the page"
    },
    "type": {
      "type": "string",
      "const": "faq"
    },
    "heading": {
      "default": "Frequently Asked Questions",
      "type": "string",
      "minLength": 1,
      "maxLength": 70
    },
    "groups": {
      "minItems": 1,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "items": {
            "minItems": 1,
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "question": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 140
                },
                "answer": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 600
                }
              },
              "required": [
                "question",
                "answer"
              ]
            }
          }
        },
        "required": [
          "items"
        ]
      }
    }
  },
  "required": [
    "id",
    "type",
    "groups"
  ]
}
