{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable id, unique within the page"
    },
    "type": {
      "type": "string",
      "const": "announcement_bar"
    },
    "messages": {
      "minItems": 1,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 90
          },
          "link": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 30
              },
              "href": {
                "type": "string",
                "pattern": "^(\\/[a-z0-9\\-\\/#?=&]*|#[a-z0-9-]+|https?:\\/\\/\\S+|mailto:\\S+|tel:\\S+)$"
              }
            },
            "required": [
              "label",
              "href"
            ]
          }
        },
        "required": [
          "text"
        ]
      }
    }
  },
  "required": [
    "id",
    "type",
    "messages"
  ]
}
